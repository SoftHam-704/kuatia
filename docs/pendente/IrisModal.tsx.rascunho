import { useEffect } from 'react';

/**
 * Modal da IRIS — conceito portado do QuickCash (`shared/components/iris/IrisModal.tsx`),
 * que por sua vez veio do RepOne v1: fundo escurecido, entrada animada, fecha no
 * Esc, no clique do fundo e no botão. Chamável de qualquer lugar pelo mesmo
 * estado — aqui pelo chip da sidebar e por Ctrl+K.
 *
 * 🔴 O que ele NÃO faz, e é preciso dizer: o Kuatiá está na **Fase 0** do PLY-006.
 * Não há loader do corpus, não há endpoint de chat, não há tool nenhuma. Em vez
 * de abrir uma caixa de pergunta que sempre erra — que é o estado do QuickCash
 * hoje, declarado no próprio código dele —, este modal mostra o que a IRIS vai
 * saber, o que já está pronto para ela e o que falta ligar.
 *
 * Uma caixa de texto que só devolve erro ensina o usuário a não usar o recurso.
 * Preferimos a moldura honesta até a Fase A subir.
 */
export function IrisModal({ open, onClose }: { open: boolean; onClose: () => void }) {
  useEffect(() => {
    if (!open) return;
    const onKey = (event: KeyboardEvent) => { if (event.key === 'Escape') onClose(); };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [open, onClose]);

  if (!open) return null;

  return (
    <div className="ds-modal-backdrop" onClick={onClose} role="presentation">
      <div
        className="ds-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="iris-title"
        onClick={(event) => event.stopPropagation()}
      >
        <header className="ds-modal__header">
          <div className="ds-row ds-row--tight">
            <span className="ds-iris__avatar" aria-hidden="true">IR</span>
            <div>
              <h2 className="ds-modal__title" id="iris-title">IRIS</h2>
              <p className="ds-help">La asistente del grupo</p>
            </div>
          </div>
          <button type="button" className="ds-btn ds-btn--ghost ds-btn--icon" onClick={onClose} aria-label="Cerrar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </header>

        <div className="ds-modal__body ds-stack">
          <div className="ds-alert ds-alert--warning" role="status">
            <div className="ds-alert__body">
              <p className="ds-alert__title">Todavía no está conectada</p>
              <p>
                La IRIS del Kuatiá aún no responde preguntas. Preferimos decirlo acá y no darte una
                caja de texto que siempre falla.
              </p>
            </div>
          </div>

          <section className="ds-stack-2">
            <h3 className="ds-section">Lo que ya sabe de este sistema</h3>
            <p className="ds-secondary">
              El manual del Kuatiá y el mapa del sistema ya están escritos y publicados. Cuando se
              encienda, la IRIS va a responder cómo se usa cada pantalla — cargar una factura en
              cuotas, registrar un pago parcial, anular un pago, pasar plata entre cajas, por qué no
              se suman guaraníes con dólares.
            </p>
          </section>

          <section className="ds-stack-2">
            <h3 className="ds-section">Lo que va a seguir sin poder responder</h3>
            <p className="ds-secondary">
              Cualquier pregunta que exija leer tus datos — <em>¿cuánto tengo en caja?</em>,
              <em> ¿qué vence esta semana?</em> — necesita otra etapa, con su propia revisión de
              seguridad. Hasta entonces, el número está en la pantalla, no acá.
            </p>
          </section>

          <p className="ds-help">
            Se abre con <strong>Ctrl + K</strong> desde cualquier pantalla y se cierra con Esc.
          </p>
        </div>

        <footer className="ds-modal__footer">
          <button type="button" className="ds-btn ds-btn--secondary" onClick={onClose}>Cerrar</button>
        </footer>
      </div>
    </div>
  );
}
